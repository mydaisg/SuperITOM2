# ── HungFo 子项目 .gitignore ──
# 目的：DSH 开发期产物、数据库二进制、运行日志不进 Git。
# 说明：父项目 .gitignore 未排除 *.DB，数据库曾被反复提交进仓库（GH_ITOM.db 达 50MB）。
#       本文件只约束 Script/hungfo/ 及其子目录。

# ── 数据库（二进制，绝不用 Git 同步）──
DB/*.DB
DB/*.db
DB/*.DB.bak*
DB/*.db.bak*
DB/*.DB.bak_*
DB/hg_*

# ── 运行日志 ──
Log/
*.log

# ── DSH 开发期临时产物 ──
.dsh/tmp/
.dsh/state/

# ── 编辑器 / 系统 ──
.Rhistory
.RData
.Rproj.user/
*.tmp
*~
Thumbs.db
desktop.ini

# ── CDP 调试浏览器用户数据目录（Edge/Chromium --user-data-dir）──
# 来源：_hf_cdp*.mjs 等 CDP 调试脚本启动 Edge 时，把 --user-data-dir 指向了项目内，
# 生成完整浏览器 profile（Local State / Default / Cache / 组件模型缓存）。
# 内含单个 >100MB 的模型文件，超过 GitHub 单文件 100MB 硬上限，会直接让 push 失败；
# 且属于浏览器运行期缓存（含 Cookie / 登录态），绝不可入库。
_hf_cdp*/
_hf_cdp*.mjs
_hf_dom*.txt
_hf_out.txt
_hf_err.txt
_hf_check.R

# ── 调试/测试临时目录与数据库备份（本地保留，不入库）──
DB/backup_*/
DB/test_tmp/
ai_context/
