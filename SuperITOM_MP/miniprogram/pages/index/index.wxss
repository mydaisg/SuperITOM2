.page {
  padding: 24rpx 24rpx 48rpx;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 28rpx;
}

.greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.logout-btn {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.workorder-entry {
  color: #667eea;
  border-color: #667eea;
}

/* 统计卡片 */
.stats {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 16rpx;
}

.stat-item {
  width: calc(33.333% - 16rpx);
  margin: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

/* 列表项 */
.item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item:last-child {
  border-bottom: none;
}

.badge {
  display: inline-block;
  flex-shrink: 0;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.item-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
