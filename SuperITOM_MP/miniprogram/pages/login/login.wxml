<view class="login-page">
  <view class="login-card">
    <view class="logo">SuperITOM</view>
    <view class="subtitle">IT 运维管理系统</view>

    <input
      class="input"
      placeholder="用户名"
      placeholder-class="input-placeholder"
      value="{{username}}"
      bindinput="onUsernameInput"
    />
    <input
      class="input"
      placeholder="密码"
      placeholder-class="input-placeholder"
      password
      value="{{password}}"
      bindinput="onPasswordInput"
      bindconfirm="onLogin"
    />

    <button class="btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">登 录</button>
  </view>
</view>
