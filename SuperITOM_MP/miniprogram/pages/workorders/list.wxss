.page {
  min-height: 100vh;
  background: #f5f6fa;
}

/* 状态 tab */
.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
  background: #f2f3f5;
}

.tab.active {
  background: #667eea;
  color: #fff;
}

/* 列表 */
.list {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.badge {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.meta {
  font-size: 24rpx;
  color: #999;
}

.prio {
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx;
}

/* 新建按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}
