.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 24rpx 140rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.header .head-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.badge {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
  word-break: break-all;
}

.tags {
  display: flex;
  align-items: center;
}

.prio {
  font-weight: 600;
  font-size: 26rpx;
}

.tag {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #666;
  background: #f2f3f5;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
  word-break: break-all;
}

.field {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

/* 操作区 */
.actions {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.action-btn {
  padding: 18rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.action-btn.primary {
  background: #667eea;
  color: #fff;
}

.action-btn.success {
  background: #5cb85c;
  color: #fff;
}

.action-btn.danger {
  background: #fff;
  color: #d9534f;
  border: 1rpx solid #d9534f;
}

.action-btn.outline {
  background: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

/* 评论 */
.comment {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment:last-child {
  border-bottom: none;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #bbb;
}

.comment-body {
  font-size: 28rpx;
  color: #444;
  word-break: break-all;
}

/* 底部评论输入栏 */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: #667eea;
  color: #fff;
}
